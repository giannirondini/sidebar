<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime (production builds): allow Apple Events to browsers, used to
	     find and focus an open tab (TabLocator). Ad-hoc builds don't need it. -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
